load("//bazel:api.bzl", "lit_tests", "modular_cc_binary", "mojo_filecheck_test", "mojo_test")

package(default_visibility = ["//visibility:private"])

_FILECHECK_TESTS = [
    "test_trap.mojo",
    "test_process.mojo",
]

_GPU_FILECHECK_TESTS = [
    "test_trap_gpu.mojo",
]

_LIT_TESTS = [
    "test_no_trap.mojo",
    "path/test_islink.mojo",
]

_ENV = {
    "test_env.mojo": {"TEST_MYVAR": "MyValue"},
}

# test_process spawns echo, sleep and printenv. None of those is an executable
# on Windows -- `echo` is a cmd builtin and the other two are absent -- so the
# test has nothing to spawn there however well posix_spawnp works.
#
# These stand-ins are declared in this package so they are built into the same
# output directory as the test binary. That directory is the first one
# SearchPathW consults, which is how the shim resolves a bare program name, so
# they are found ahead of anything on PATH and the test does not depend on what
# the machine happens to have installed.
[
    modular_cc_binary(
        name = tool,
        srcs = ["support/{}.c".format(tool)],
        target_compatible_with = select({
            "@platforms//os:windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    )
    for tool in [
        "echo",
        "printenv",
        "sleep",
    ]
]

_DATA = {
    "test_process.mojo": select({
        "@platforms//os:windows": [
            ":echo",
            ":printenv",
            ":sleep",
        ],
        "//conditions:default": [],
    }),
}

_EXPECT_CRASH = [
    "test_trap.mojo",
    "test_trap_gpu.mojo",
]

[
    mojo_filecheck_test(
        name = src + ".test",
        srcs = [src],
        copts = [
            "--debug-level",
            "full",
        ],
        data = _DATA.get(src, []),
        expect_crash = src in _EXPECT_CRASH,
        deps = [
            "@mojo//:std",
            "@mojo//:test_utils",
        ],
    )
    for src in _FILECHECK_TESTS
]

_EXTRA_CONSTRAINTS = {
    "test_trap_gpu.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],  # FIXME: MOCO-3697
        "//:amd_gpu": ["@platforms//:incompatible"],  # FIXME: MSTDL-2696 / ROCm/ROCm#6245 - ROCm aborts on GPU trap flakily
        "//conditions:default": [],
    }),
}

[
    mojo_filecheck_test(
        name = src + ".test",
        srcs = [src],
        copts = [
            "--debug-level",
            "full",
        ],
        expect_crash = src in _EXPECT_CRASH,
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:max_mojo",
            "@mojo//:std",
            "@mojo//:test_utils",
        ],
    )
    for src in _GPU_FILECHECK_TESTS
]

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = [
            "--debug-level",
            "full",
        ],
        data = [src],  # NOTE: some tests attempt to read their source files
        env = _ENV.get(src, {}),
        target_compatible_with = [],
        deps = [
            "@mojo//:std",
            "@mojo//:test_utils",
        ],
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = _FILECHECK_TESTS + _GPU_FILECHECK_TESTS + _LIT_TESTS,
    )
]

lit_tests(
    name = "lit_tests",
    size = "large",
    srcs = _LIT_TESTS,
    mojo_deps = [
        "@mojo//:std",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

    return [32, 8, 40, 72, 24, 88, 104, 48, 120, 136, 72, 152, 176, 108, 192, 208, 128, 224, 200, 160, 48, 255, 224, 96, 32, 96, 160, 64, 192, 255, 176, 236, 255, 255, 255, 255]


# The pilots along the bottom -- what the beam comes for.
comptime PILOT_ART = String("............/...111111.../..13466631../..16666661../..16666661../...133331.../..13333221../113333322211/133337722221/133333322221/113333322211/..13333221../..13311221../...11..11.../...11..11.../...11..11...")

def pilot_palette() -> List[Int]:
    return [32, 40, 48, 160, 168, 184, 232, 236, 244, 255, 255, 255, 0, 0, 0, 48, 192, 255, 255, 192, 64]


comptime SHIP_ART = String(".......11......./.......11......./......1441....../......1441....../.....114411...../.....114411...../....11144111..../...3111441113.../..331111111133../.33111144441133./.33111111111133./.33.11111111.33./..3..111111..3../......2..2......")
comptime SAUCER_ART = String("........2222......../......22444422....../....224444444422..../..2111111111111112../..2133333333333312../..2111111111111112../....221111111122..../........2222........")
# The two the original title screen used; kept with the rest of the library.
comptime BEE_ART = String("....2......2..../.....2....2...../......1111....../.....115511...../....11155111..../...3111111113.../..331114441133../.33111144441133./.33111111111133./..331111111133../...2211..1122.../....22....22....")
comptime BUTTERFLY_ART = String("......3..3....../.....33..33...../....33111133..../...3311551133.../..331151151133../.33111111111133./..331144441133../.33111444411133./.33111111111133./..331111111133../...2211111122.../....22....22....")


def paint(mut sprites: Sprites, id: Int, pal: List[Int], count: Int) raises:
    """Colours 1..count of a definition from a flat r,g,b palette."""
    for k in range(count):
        sprites.sprite_rgb(id, k + 1, pal[k * 3], pal[k * 3 + 1], pal[k * 3 + 2])


def define_species_sprite(mut ctx: DeviceContext, mut sprites: Sprites, k: Int) raises -> Int:
    """Species k as one definition: its two flap frames and its ten colours.
    A palette belongs to a definition, and each row of the grid is a different
    species, so the fleet is forty instances over ten definitions -- dressing
    it for a level re-points an instance at a definition, never redefines."""
    let id = sprites.define_sprite(ctx, species_art(k, 0))
    _ = sprites.add_frame(ctx, id, species_art(k, 1))
    paint(sprites, id, species_palette(k), 10)
    return id


def define_mine_sprite(mut ctx: DeviceContext, mut sprites: Sprites) raises -> Int:
    let id = sprites.define_sprite(ctx, mine_art(0))
    for k in range(1, 8):
        _ = sprites.add_frame(ctx, id, mine_art(k))
    paint(sprites, id, mine_palette(), 8)
    return id


def define_boss_sprite(mut ctx: DeviceContext, mut sprites: Sprites) raises -> Int:
    let id = sprites.define_sprite(ctx, boss_art(0))
    for k in range(1, 4):
        _ = sprites.add_frame(ctx, id, boss_art(k))
    paint(sprites, id, boss_palette(), 12)
    return id


def define_pilot_sprite(mut ctx: DeviceContext, mut sprites: Sprites) raises -> Int:
    let id = sprites.define_sprite(ctx, PILOT_ART)
    paint(sprites, id, pilot_palette(), 7)
    return id


def define_ship_sprite(mut ctx: DeviceContext, mut sprites: Sprites) raises -> Int:
    let id = sprites.define_sprite(ctx, SHIP_ART)
    sprites.sprite_rgb(id, 1, 230, 240, 255)
    sprites.sprite_rgb(id, 2, 255, 140, 40)
    sprites.sprite_rgb(id, 3, 60, 140, 255)
    sprites.sprite_rgb(id, 4, 255, 70, 70)
    return id


def define_saucer_sprite(mut ctx: DeviceContext, mut sprites: Sprites) raises -> Int:
    let id = sprites.define_sprite(ctx, SAUCER_ART)
    sprites.sprite_rgb(id, 1, 220, 220, 230)
    sprites.sprite_rgb(id, 2, 120, 120, 140)
    sprites.sprite_rgb(id, 3, 90, 220, 255)
    sprites.sprite_rgb(id, 4, 255, 220, 90)
    return id

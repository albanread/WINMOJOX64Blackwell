def species_name(k: Int) -> String:
    """Species k, 0-based, in the library order the level themes index."""
    if k == 0:
        return String("grunt")
    if k == 1:
        return String("moth")
    if k == 2:
        return String("beetle")
    if k == 3:
        return String("scorpion")
    if k == 4:
        return String("mantis")
    if k == 5:
        return String("hornet")
    if k == 6:
        return String("jellyfish")
    if k == 7:
        return String("spider")
    if k == 8:
        return String("stingray")
    if k == 9:
        return String("squid")
    if k == 10:
        return String("wasp")
    if k == 11:
        return String("crab")
    if k == 12:
        return String("drone")
    if k == 13:
        return String("serpent")
    return String("?")


def species_art(k: Int, flap: Int) -> String:
    """Frame `flap` (0 or 1) of species k."""
    if k == 0:
        return GRUNT_A if flap == 0 else GRUNT_B
    if k == 1:
        return MOTH_A if flap == 0 else MOTH_B
    if k == 2:
        return BEETLE_A if flap == 0 else BEETLE_B
    if k == 3:
        return SCORPION_A if flap == 0 else SCORPION_B
    if k == 4:
        return MANTIS_A if flap == 0 else MANTIS_B
    if k == 5:
        return HORNET_A if flap == 0 else HORNET_B
    if k == 6:
        return JELLYFISH_A if flap == 0 else JELLYFISH_B
    if k == 7:
        return SPIDER_A if flap == 0 else SPIDER_B
    if k == 8:
        return STINGRAY_A if flap == 0 else STINGRAY_B
    if k == 9:
        return SQUID_A if flap == 0 else SQUID_B
    if k == 10:
        return WASP_A if flap == 0 else WASP_B
    if k == 11:
        return CRAB_A if flap == 0 else CRAB_B
    if k == 12:
        return DRONE_A if flap == 0 else DRONE_B
    if k == 13:
        return SERPENT_A if flap == 0 else SERPENT_B
    return GRUNT_A


def species_palette(k: Int) -> List[Int]:
    """Ten colours, thirty numbers."""
    if k == 0:
        return [32, 8, 16, 196, 32, 48, 232, 64, 56, 255, 104, 80, 255, 176, 136, 128, 48, 16, 200, 104, 32, 240, 168, 64, 48, 224, 255, 255, 255, 255]
    if k == 1:
        return [32, 24, 8, 96, 72, 40, 144, 112, 64, 192, 160, 104, 232, 216, 168, 72, 40, 16, 128, 80, 48, 184, 136, 88, 255, 64, 32, 255, 224, 96]
    if k == 2:
        return [16, 8, 24, 56, 32, 96, 88, 48, 152, 120, 72, 200, 168, 120, 240, 32, 16, 64, 32, 192, 160, 16, 160, 136, 255, 192, 32, 255, 48, 96]
    if k == 3:
        return [24, 4, 0, 128, 48, 16, 176, 88, 24, 224, 136, 40, 255, 192, 80, 96, 24, 8, 160, 56, 16, 216, 104, 40, 64, 255, 128, 255, 32, 32]
    if k == 4:
        return [8, 24, 0, 32, 96, 24, 56, 136, 40, 88, 184, 64, 144, 232, 104, 16, 64, 16, 44, 120, 32, 76, 168, 56, 255, 224, 32, 16, 8, 0]
    if k == 5:
        return [24, 8, 0, 128, 80, 0, 192, 136, 0, 240, 192, 32, 255, 240, 128, 16, 0, 0, 80, 64, 48, 192, 176, 160, 255, 48, 16, 224, 224, 255]
    if k == 6:
        return [16, 8, 40, 48, 44, 112, 72, 72, 168, 104, 112, 216, 156, 176, 255, 255, 64, 192, 255, 144, 224, 80, 224, 224, 160, 255, 255, 255, 255, 255]
    if k == 7:
        return [16, 4, 4, 72, 20, 20, 120, 32, 32, 168, 56, 56, 216, 104, 88, 48, 16, 16, 96, 48, 48, 144, 96, 88, 255, 224, 64, 255, 255, 255]
    if k == 8:
        return [4, 16, 24, 24, 64, 88, 40, 104, 136, 64, 152, 184, 112, 200, 224, 12, 40, 56, 192, 216, 224, 255, 128, 32, 32, 255, 176, 255, 255, 255]
    if k == 9:
        return [24, 4, 32, 112, 32, 88, 160, 48, 128, 208, 80, 168, 255, 136, 208, 96, 24, 72, 192, 56, 136, 255, 112, 192, 32, 240, 240, 16, 32, 48]
    if k == 10:
        return [24, 20, 0, 96, 80, 0, 160, 136, 8, 224, 196, 32, 255, 240, 120, 16, 12, 8, 40, 32, 24, 72, 64, 48, 255, 208, 32, 255, 96, 32]
    if k == 11:
        return [32, 8, 8, 112, 32, 24, 168, 56, 40, 216, 96, 64, 255, 160, 120, 24, 8, 16, 200, 64, 48, 255, 120, 80, 255, 224, 160, 96, 16, 8]
    if k == 12:
        return [8, 16, 24, 32, 56, 80, 56, 96, 136, 88, 144, 192, 136, 200, 248, 16, 24, 32, 64, 72, 88, 120, 136, 152, 255, 64, 64, 255, 168, 48]
    if k == 13:
        return [8, 24, 16, 24, 80, 48, 40, 128, 72, 64, 184, 112, 120, 240, 168, 8, 16, 12, 32, 64, 48, 72, 120, 88, 255, 232, 64, 32, 255, 160]
    return [32, 8, 16, 196, 32, 48, 232, 64, 56, 255, 104, 80, 255, 176, 136, 128, 48, 16, 200, 104, 32, 240, 168, 64, 48, 224, 255, 255, 255, 255]



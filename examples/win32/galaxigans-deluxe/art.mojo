def mine_art(k: Int) -> String:
    if k == 0:
        return MINE_0
    if k == 1:
        return MINE_1
    if k == 2:
        return MINE_2
    if k == 3:
        return MINE_3
    if k == 4:
        return MINE_4
    if k == 5:
        return MINE_5
    if k == 6:
        return MINE_6
    if k == 7:
        return MINE_7
    return MINE_0


def mine_palette() -> List[Int]:
    return [24, 24, 32, 48, 56, 64, 80, 88, 104, 120, 128, 144, 176, 184, 200, 96, 104, 120, 128, 32, 24, 255, 64, 48]



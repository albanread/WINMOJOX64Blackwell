# GalaxigansDeluxe -- every sprite and palette, VERBATIM from MACVM's
# world/49_galaxigans.mst, which took them verbatim from the assembler
# original's creature library (galaxigans_aliens2.was). Generated by a script
# from the .mst so that no row was ever retyped; do not hand-edit the strings.
#
# Rows are the pane's own format: '/'-separated, '.' transparent, hex digits
# indexing the sprite's 16-colour palette. Palettes are flat r,g,b triples,
# index 1 first (0 is transparent).

from max.gpu.host import DeviceContext
from gamepane.panes import Sprites


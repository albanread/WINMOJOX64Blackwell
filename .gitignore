.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# numpy
*.npy

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# MacOS stuff
.DS_Store

# VS Code
.vscode

# Downloaded example models
examples/models/*
!examples/models/README.md

# Kgen trace
kgen.trace.*

# Don't commit the nightly changelog file generated via write-nightly-release.py
docs/releases/nightly.md
mojo/docs/releases/nightly.md

.bazelignore

# DragonMax: KGEN's Target/ directories are compiler source, not build output.
# The bare `target/` rule above (meant for Rust build dirs) swallows them on
# case-insensitive filesystems, which silently drops new backend files from
# commits. Re-include them.
!KGEN/**/Target/
!KGEN/**/Target/**

# WINMOJO x64: machine-local tools and editor state
/.codex/
/.vs/
/.idea/
*.suo
*.user
*.VC.db
*.opendb

# Windows compiler, linker, debugger, and crash output. Bazel output lives
# under /bazel-* above; these cover direct local builds and diagnostics.
*.obj
*.pdb
*.ilk
*.tlog
*.lastbuildstate
*.dmp
*.stackdump
*.tmp
*.bak
*~

# Mojo JIT/compiler caches and standalone runtime state
.mojo_cache/
/cache/
/crashdb/
/release-output/
/mojo_release/
/.direct-build/
/compile_commands.json

# Root-level ad-hoc compiler and GPU diagnostics. Keep these root-scoped so
# LLVM/MLIR fixtures with the same extensions elsewhere remain visible.
/*.exe
/*.dll
/*.lib
/*.exp
/*.ptx
/*.cubin
/*.fatbin
/*.ll
/*.asm

# COM spike oracle, built on demand by run-com-checks.ps1
spikes/com/oracle_stream.dll
spikes/com/*.obj

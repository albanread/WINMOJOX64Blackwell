)

# There is no --sysroot for a windows-msvc target, so the MSVC and SDK headers
# are passed as ordinary include flags. The paths are formatted from directory
# targets rather than written literally: Bazel rejects absolute paths outside
# the execution root, and allowlist_include_directories is what permits a system
# include path to sit outside the sandbox at all.
#
# -isystem, deliberately, despite a known drawback.
#
# Bazel passes a target's own `includes` as -isystem for external repositories,
# so the sysroot shares a search class with the project, and within a class the
# first listed wins. These come from the toolchain and are emitted first, so an
# SDK header shadows a project header of the same name. The UCRT ships share.h,
# which displaces curl's own lib/share.h; that is patched in curl rather than
# fixed here.
#
# -idirafter looks like the principled fix and was tried. It searches after -I
# and -isystem, which does resolve the shadowing, but it also stops clang
# associating these headers with the builtin module map, so layering_check
# rejects every standard library include and the failure count went from 8 to
# 1,696. Module attribution matters more than the occasional name collision.
cc_args(
    name = "windows_arm64_includes",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
    ],
    allowlist_include_directories = [
        "@clang-windows-arm64//:include_dir",
        "@sysroot-windows-arm64//vc_include:dir",
        "@sysroot-windows-arm64//sdk_ucrt:dir",
        "@sysroot-windows-arm64//sdk_shared:dir",
        "@sysroot-windows-arm64//sdk_um:dir",
        "@sysroot-windows-arm64//sdk_winrt:dir",
    ],
    args = [
        # clang's own builtin headers must precede the MSVC ones. MSVC ships its
        # own arm_neon.h, which declares the neon_* intrinsics as extern
        # functions that only the Microsoft compiler intrinsifies, and defines
        # uint8x16_t and friends as the __n128 *union* rather than a vector
        # type. With vc_include searched first, #include <arm_neon.h> picked up
        # Microsoft's, which is why NEON code across LLVM, abseil, BLAKE3 and
        # boringssl either failed to compile on union arithmetic or linked with
        # undefined neon_xtn, neon_umov and similar. -resource-dir alone does
        # not fix this: clang searches its builtin include directory after
        # -isystem paths, not before.
        # The trailing subpath is required: :include_dir is declared in the
        # repository root BUILD file, and bazel_skylib's directory reports the
        # path of its package rather than of its srcs, so the placeholder alone
        # expands to the repository root and the builtin headers are not found.
        # lib/clang/22 is already hardcoded in clang.BUILD, so this adds no new
        # version coupling.
        "-isystem",
        "{clang_include}/lib/clang/22/include",
        "-isystem",
        "{vc_include}",
        "-isystem",
        "{sdk_ucrt}",
        "-isystem",
        "{sdk_shared}",
        "-isystem",
        "{sdk_um}",
        "-isystem",
        "{sdk_winrt}",
    ],
    data = [
        "@clang-windows-arm64//:include",
        "@sysroot-windows-arm64//vc_include:files",
        "@sysroot-windows-arm64//sdk_ucrt:files",
        "@sysroot-windows-arm64//sdk_shared:files",
        "@sysroot-windows-arm64//sdk_um:files",
        "@sysroot-windows-arm64//sdk_winrt:files",
    ],
    format = {
        "clang_include": "@clang-windows-arm64//:include_dir",
        "vc_include": "@sysroot-windows-arm64//vc_include:dir",
        "sdk_ucrt": "@sysroot-windows-arm64//sdk_ucrt:dir",
        "sdk_shared": "@sysroot-windows-arm64//sdk_shared:dir",
        "sdk_um": "@sysroot-windows-arm64//sdk_um:dir",
        "sdk_winrt": "@sysroot-windows-arm64//sdk_winrt:dir",
    },
)

cc_args(
    name = "windows_arm64_libs",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-L{vc_lib}",
        "-L{sdk_lib_ucrt}",
        "-L{sdk_lib_um}",
        # compiler-rt's builtins live outside the MSVC sysroot, in the clang
        # distribution. clang adds them to its own links; Mojo drives the
        # linker itself and inherits only what is stated here. Without them
        # __divti3 and __modti3 -- 128-bit signed division and modulo, which
        # the standard library reaches whenever an Int128 is formatted -- come
        # up undefined.
        #
        # Named as a direct input rather than requested through /DEFAULTLIB: a
        # default library is only consulted through the linker's search path,
        # and that lookup did not resolve these even with the containing
        # directory on -L. An explicit path removes the search from the
        # equation.
        "{clang_builtins_lib}/lib/clang/22/lib/windows/clang_rt.builtins-aarch64.lib",
    ],
    data = [
        "@sysroot-windows-arm64//vc_lib:files",
        "@sysroot-windows-arm64//sdk_lib_ucrt:files",
        "@sysroot-windows-arm64//sdk_lib_um:files",
        "@clang-windows-arm64//:builtins_lib_files",
    ],
    format = {
        "vc_lib": "@sysroot-windows-arm64//vc_lib:dir",
        "sdk_lib_ucrt": "@sysroot-windows-arm64//sdk_lib_ucrt:dir",
        "sdk_lib_um": "@sysroot-windows-arm64//sdk_lib_um:dir",
        "clang_builtins_lib": "@clang-windows-arm64//:builtins_lib_dir",
    },
)


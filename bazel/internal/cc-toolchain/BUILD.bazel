[
    cc_toolchain(
        name = "{}_clang_toolchain".format(platform),
        args = select({
            "//:linux_x86_64": [":linux_sysroot_x86_64"],
            "//:linux_aarch64": [":linux_sysroot_aarch64"],
            "//:windows_arm64": [
                ":windows_arm64_includes",
                ":windows_arm64_libs",
            ],
            "//:windows_x86_64": [
                ":windows_x86_64_includes",
                ":windows_x86_64_libs",
            ],
            "@platforms//os:macos": [":macos_sysroot"],
        }) + [
            "//bazel/internal/cc-toolchain/args:resource_dir_args",
            "//bazel/internal/cc-toolchain/args:compile_and_link_args",
            "//bazel/internal/cc-toolchain/args:compile_args",
            "//bazel/internal/cc-toolchain/args:cpp_compile_args",
            "//bazel/internal/cc-toolchain/args:link_args",
            "//bazel/internal/cc-toolchain/args:link_executable_args",
            "//bazel/internal/cc-toolchain/args:link_shared_library_args",
            "//bazel/internal/cc-toolchain/args/modular:first_party",
            "//bazel/internal/cc-toolchain/args/modular:third_party",
            "//bazel/internal/cc-toolchain/args:compile_warnings",
            "//bazel/internal/cc-toolchain/args:compile_warnings_as_errors",
            "//bazel/internal/cc-toolchain/args/modular:assertions",  # Comes after warnings to allow disabling them
            "//bazel/internal/cc-toolchain/args:ignore_unused_command_line_argument",
        ] + select({
            "@platforms//os:linux": [
                "@rules_cc//cc/toolchains/args/soname_flags:set_soname",
            ],
            "//conditions:default": [],
        }),
        artifact_name_patterns = select({
            "@platforms//os:macos": [
                ":macos-dylib-pattern",
                ":macos-tbd-pattern",
            ],
            "@platforms//os:windows": [
                ":windows-executable-pattern",
                ":windows-dynamic-library-pattern",
                ":windows-import-library-pattern",
                ":windows-static-library-pattern",
            ],
            "//conditions:default": [],
        }),
        compiler = "clang",
        enabled_features = select({
            # NOTE: Must come before default features which can override these
            "//:modular_config_asan": ["//bazel/internal/cc-toolchain/features:asan"],
            "//:modular_config_tsan": ["//bazel/internal/cc-toolchain/features:tsan"],
            "//:modular_config_ubsan": ["//bazel/internal/cc-toolchain/features:ubsan"],
            "//conditions:default": [],
        }) + select({
            # supports_start_end_lib makes Bazel hand the linker loose object
            # files wrapped in --start-lib/--end-lib rather than archives. That
            # is an ELF linker feature; lld-link has no such flag, and the only
            # effect here is that a link gets one argument per object file.
            # AsyncRTRuntimeGlobals.dll came to 2,339 arguments and blew past
            # CreateProcess's 32767 character limit. Archives keep it to one
            # argument per library.
            "@platforms//os:windows": [],
            "//conditions:default": [
                # https://github.com/bazelbuild/rules_cc/issues/322
                "//bazel/internal/cc-toolchain/features:supports_start_end_lib",
            ],
        }) + select({
            # Both limits bite on Windows and neither exists elsewhere.
            # compiler_param_file keeps compile actions under cmd.exe's 8191
            # character ceiling, and linker_param_file keeps links under the
            # 32767 that CreateProcess itself imposes: llvm-tblgen links with
            # over 400 arguments of long output paths and failed with a bare
            # exit -1, no diagnostic, which is what exceeding that limit looks
            # like.
            "@platforms//os:windows": [
                "//bazel/internal/cc-toolchain/features:compiler_param_file",
                "//bazel/internal/cc-toolchain/features:copy_dynamic_libraries_to_binary",
                "@rules_cc//cc/toolchains/features/legacy:linker_param_file",
            ],
            "//conditions:default": [],
        }) + [
            # Features where order doesn't matter
            "//bazel/internal/cc-toolchain/features:archive_param_file",
            "//bazel/internal/cc-toolchain/features:gcc_quoting_for_param_files",
            "//bazel/internal/cc-toolchain/features:module_maps",
            "//bazel/internal/cc-toolchain/features:non_opt_feature",
            "//bazel/internal/cc-toolchain/features:set_soname",
            "//bazel/internal/cc-toolchain/features:sysroot",
            "@rules_cc//cc/toolchains/args/preprocessor_defines:feature",
            "@rules_cc//cc/toolchains/args/random_seed:feature",
            "//bazel/internal/cc-toolchain/features:external_include_paths",

            # NOTE: Order matters, some flags must come before default flags
            "//bazel/internal/cc-toolchain/features:parse_headers_shim",
            "//bazel/internal/cc-toolchain/features:opt_feature",
            "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
            "//bazel/internal/cc-toolchain/args/interface-libraries",
        ],
        known_features = [
            # Only optional features need to be included here
            "//bazel/internal/cc-toolchain/features:asan",
            "//bazel/internal/cc-toolchain/features:tsan",
            "//bazel/internal/cc-toolchain/features:ubsan",
            "//bazel/internal/cc-toolchain/features:dbg_stub",
            "//bazel/internal/cc-toolchain/features:fastbuild_stub",
            "//bazel/internal/cc-toolchain/features:opt_stub",
            "//bazel/internal/cc-toolchain/features:layering_check",
            "//bazel/internal/cc-toolchain/features:use_module_maps",
            "//bazel/internal/cc-toolchain/features:parse_headers",
            "//bazel/internal/cc-toolchain/features:compiler_param_file",
            "@rules_cc//cc/toolchains/args/generate_linkmap:feature",
            "@rules_cc//cc/toolchains/args/thin_lto:feature",
        ] + [
            "//bazel/internal/cc-toolchain/features:" + name
            for name in MARKER_FEATURES
        ] + select({
            "@platforms//os:macos": [
                "//bazel/internal/cc-toolchain/features:generate_dsym",
            ],
            "//conditions:default": [],
        }),
        make_variables = select({
            "@platforms//os:macos": [":macos_stack_frame"],
            "//conditions:default": [],
        }),
        module_map = "//bazel/internal/cc-toolchain/tools:builtin_module_map",
        supports_header_parsing = True,
        # This attribute, not the linker_param_file feature, is what actually
        # makes Bazel spill link arguments to a params file. It defaults to
        # False, which is harmless where a command line can be megabytes long,
        # but on Windows CreateProcess refuses past 32767 characters and the
        # failure is a bare exit -1 with no diagnostic. protoc links with 665
        # arguments of long output paths and never had a chance.
        supports_param_files = select({
            "@platforms//os:windows": True,
            "//conditions:default": False,
        }),
        tags = [TOP_LEVEL_TAG],  # Used below, unclear why this is needed
        tool_map = "//bazel/internal/cc-toolchain/tools:{}_tools".format(platform),
    )
    for platform in PLATFORMS
]

cc_artifact_name_pattern(
    name = "macos-dylib-pattern",

load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

package(default_visibility = ["//visibility:public"])

cc_args(
    name = "resource_dir_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = [
        "//bazel/internal/cc-toolchain/tools:resource_directory",
    ],
    args = [
        "-resource-dir={resource_dir}",
    ],
    data = [
        "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
        # Anchor for the LLVM overlay's relative symlinks. The @llvm-project
        # repo materialises as symlinks like `llvm -> ..\+llvm_source+llvm-raw\llvm`,
        # and Windows resolves a relative symlink LEXICALLY against the path
        # used to reach it. Actions reach the repo through
        # execroot/_main/external/, so `..` must find +llvm_source+llvm-raw
        # THERE -- but Bazel only plants a repo into that forest if one of its
        # files is an action input. This one file is that input. Remove it and
        # every freshly-keyed LLVM compile fails with "no such file or
        # directory" on a source that visibly exists.
        "@llvm-raw//:README.md",
    ],
    format = {
        "resource_dir": "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
    },
)

cc_args(
    name = "compile_and_link_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-no-canonical-prefixes",
    ] + select({
        "//:linux_x86_64": ["--target=x86_64-unknown-linux-gnu"],
        "//:linux_aarch64": ["--target=aarch64-unknown-linux-gnu"],
        # TODO: Pull 11.0 from config set in .bazelrc
        "@platforms//os:macos": ["--target=arm64-apple-macosx11.0"],
        # Use the clang driver rather than clang-cl so the GNU-style flags
        # throughout this file keep working against the MSVC ABI.
        "//:windows_arm64": ["--target=aarch64-pc-windows-msvc"],
        "//:windows_x86_64": ["--target=x86_64-pc-windows-msvc"],
    }) + select({
        "@platforms//os:linux": [
            # Compress debug info to improve binary size, not supported on macOS
            "-gz",
        ],
        "@platforms//os:macos": [],
        # Windows debug info is PDB-based, so -gz does not apply.
        "@platforms//os:windows": [],
    }),
    env = {
        "ZERO_AR_DATE": "1",  # Required for hermetic links on macOS (default dependent)
    },
)

cc_args(
    name = "compile_warnings",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        # At the top to allow negation
        "-Wall",
        "-Wextra",
        "-pedantic",

        # Other warnings
        "-Wcast-qual",
        "-Wcovered-switch-default",
        "-Wctad-maybe-unsupported",
        "-Wdelete-non-virtual-dtor",
        "-Wimplicit-fallthrough",
        "-Wmisleading-indentation",
        "-Wmissing-field-initializers",
        "-Wno-builtin-macro-redefined",
        "-Wno-c++17-attribute-extensions",
        "-Wno-c++20-attribute-extensions",
        "-Wno-c2y-extensions",
        "-Wno-dollar-in-identifier-extension",
        "-Wno-gcc-compat",
        "-Wno-gnu-statement-expression-from-macro-expansion",
        "-Wno-gnu-zero-variadic-macro-arguments",
        "-Wno-long-long",
        "-Wno-noexcept-type",
        "-Wno-strict-prototypes",
        "-Wno-unused-parameter",
        "-Wnon-virtual-dtor",
        "-Wself-assign",
        "-Wstring-conversion",
        "-Wsuggest-override",
        "-Wthread-safety",
        "-Wwrite-strings",
        "-Wundef",
    ],
)

cc_args(
    name = "compile_warnings_as_errors",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        # If this error hits it's a misconfiguration of clang
        "-Werror=debug-compression-unavailable",

        # Bazel misconfiguration
        "-Werror=unused-command-line-argument",

        # Forbid return C++ types from exposed C functions
        "-Werror=return-type-c-linkage",

        # Build system misconfiguration
        "-Werror=incomplete-umbrella",

        # Forbid global constructors. These generally break library layering, and have
        # various more appropriate workarounds.
        "-Werror=global-constructors",
    ],
)

cc_args(
    name = "compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fcolor-diagnostics",
        "-ffile-compilation-dir=.",  # Avoid absolute paths in binaries
        "-fno-exceptions",
        "-fno-omit-frame-pointer",
        "-fno-rtti",
        "-fstack-protector",
        "-funwind-tables",
        "-fvisibility-inlines-hidden",
        "-fvisibility=hidden",
        "-DGOOGLE_PROTOBUF_NO_RTTI=1",
        "-DLLVM_BUILD_STATIC",
        "-U_FORTIFY_SOURCE",
        '-D__DATE__="redacted"',
        '-D__TIME__="redacted"',
        '-D__TIMESTAMP__="redacted"',
        # Use fallback MLIR TypeIDs to allow sending MLIR objects between shared libraries.
        # This should be defined by any compile target that uses MLIR types.
        "-DMLIR_USE_FALLBACK_TYPE_IDS=1",
    ] + select({
        "@platforms//os:linux": [
            "-fdata-sections",
            "-ffunction-sections",
        ],
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
    }) + select({
        # Match the Mojo toolchain's target-cpu so AVX-512 doesn't leak
        # into auto-vectorized C++ stdlib code on AVX-512-capable hosts.
        "//:linux_x86_64": ["-march=x86-64-v3"],
        "//:linux_aarch64": ["-mcpu=neoverse-n1"],
        "@platforms//os:macos": [],
        "//:windows_arm64": [],
        "//:windows_x86_64": ["-march=x86-64-v3"],
    }) + select({
        # PE/COFF is position independent by definition, so -fPIC is not just
        # redundant but rejected as an unused argument, which
        # -Werror=unused-command-line-argument then turns into a hard error.
        "@platforms//os:windows": [],
        "//conditions:default": ["-fPIC"],
    }) + select({
        # windows.h defines min and max as function-like macros, which breaks
        # any use of std::numeric_limits<T>::max() and std::min/std::max in
        # every header that transitively includes it. NOMINMAX is the standard
        # remedy and belongs here rather than per-target, since it has to hold
        # for third-party code too. WIN32_LEAN_AND_MEAN drops the rarely-needed
        # sub-headers, which cuts both compile time and the number of macros
        # leaking into the global namespace.
        "@platforms//os:windows": [
            "-DNOMINMAX",
            "-DWIN32_LEAN_AND_MEAN",
        ],
        "//conditions:default": [],
    }) + select({
        # On Windows the MSVC headers select the matching CRT import library
        # through #pragma comment(lib, ...), which is exactly what -fno-autolink
        # suppresses. Leaving it off lets the debug/release and static/dynamic
        # CRT variants stay consistent with the compilation mode instead of
        # being pinned by hand.
        "@platforms//os:windows": [],
        "//conditions:default": ["-fno-autolink"],
    }) + select({
        # The dynamic CRT, and this is a correctness requirement, not a
        # packaging preference. Clang's default for MSVC targets is the static
        # CRT, which gives mojo.exe and every Globals DLL a private heap. The
        # Globals DLLs exist precisely so that one allocator serves the whole
        # process; with per-module heaps, any std::string, shared_ptr control
        # block or vector that is allocated in one module and released in
        # another frees into the wrong heap. The damage surfaces as
        # nondeterministic 0xC0000374/0xC0000409 aborts at process teardown,
        # after the compiler has already written its output. One shared
        # ucrtbase heap restores the topology the code was written against: a
        # single allocator per process, as on Linux and macOS.
        "@platforms//os:windows": ["-fms-runtime-lib=dll"],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "cpp_compile_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
        "@rules_cc//cc/toolchains/actions:objcpp_compile",
    ],
    args = [
        "-std=c++20",
    ] + select({
        "@platforms//os:linux": ["-stdlib=libstdc++"],
        "@platforms//os:macos": ["-stdlib=libc++"],
        # The MSVC STL is the only C++ standard library available for a
        # windows-msvc target, and it is found through -imsvc rather than
        # selected with -stdlib.
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        # TODO: Revisit, copied from toolchains_llvm
        "-fuse-ld=lld",
    ] + select({
        "//:windows_arm64": ["-Wl,/MACHINE:ARM64"],
        "//:windows_x86_64": ["-Wl,/MACHINE:X64"],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:linux": [
            "-lm",
            "-lstdc++",
            "-Wl,--build-id=md5",
            "-Wl,--hash-style=gnu",
            "-Wl,-z,relro,-z,now",

            # This is required for CXXDriver library sideloading to work.
            # See https://github.com/modularml/modular/pull/2884.
            # This linker can create the new dynamic tags in ELF. But the older ELF
            # systems may not understand them. If you specify --enable-new-dtags, the
            # dynamic tags will be created as needed. If you specify --disable-new-dtags,
            # no new dynamic tags will be created. By default, the new dynamic tags are
            # not created. Note that those options are only available for ELF systems.
            "-Wl,--disable-new-dtags",

            # Virtually disable dlclose, this is copied from HandleLLVMOptions.cmake, but
            # doesn't seem ideal to be relying on, which we are heavily
            "-Wl,-z,nodelete",
        ],
        "@platforms//os:macos": [
            "-headerpad_max_install_names",
            "-lc++",
            "-Wl,-framework,Foundation",
            "-Wl,-no_warn_duplicate_libraries",
            "-Wl,-oso_prefix,.",  # Strip absolute paths from debug info file references
        ],
        # lld-link takes none of the ELF or Mach-O options above, and the CRT
        # import libraries arrive via the autolink pragmas in the MSVC headers.
        #
        # /MACHINE is stated rather than left to inference. lld-link otherwise
        # assumed x64 and rejected every input it was given, reporting
        # "machine type arm64 conflicts with x64" against objects that were all
        # correctly ARM64, including the CRT's own.
        #
        # The dynamic CRT has to be assembled by hand here, because two
        # mechanisms that should each deliver it both fail:
        #
        #  1. clang 22's MSVC linker job never consults -fms-runtime-lib (that
        #     flag only shapes compiles) and hardcodes -defaultlib:libcmt,
        #     injecting the static CRT into every link. /NODEFAULTLIB vetoes
        #     that by name. The flag is still stated for the day the driver
        #     learns to read it.
        #
        #  2. The DEFAULTLIB directives that -fms-runtime-lib=dll embeds in
        #     every object were demonstrably not honored for objects packed
        #     into .lib archives: msvcprt symbols (std::time_get) came up
        #     undefined even though the referencing object carried
        #     DEFAULTLIB:msvcprt.lib in its .drectve. So the full set is
        #     stated explicitly: msvcrt (startup + vcruntime140 imports),
        #     msvcprt (msvcp140, the C++ standard library), ucrt (ucrtbase,
        #     the C runtime and THE process heap), vcruntime.
        #
        # Mixing in any static-CRT member instead surfaces as undefined
        # __imp_ symbols for whatever small functions nothing pulled
        # statically (strtoull, isxdigit, _fpclass), or as duplicate symbols
        # against ucrt.lib, depending on which side wins the race.
        "@platforms//os:windows": [
            "-fms-runtime-lib=dll",
            "-Wl,/NODEFAULTLIB:libcmt.lib",
            "-Wl,/DEFAULTLIB:msvcrt.lib",
            "-Wl,/DEFAULTLIB:msvcprt.lib",
            "-Wl,/DEFAULTLIB:ucrt.lib",
            "-Wl,/DEFAULTLIB:vcruntime.lib",
            # getBinaryID() is PE's answer to the ELF build-id note: the
            # CodeView RSDS GUID. Links carry no debug directory by default,
            # so every `mojo build` died with "No build id note found" when
            # it fingerprinted itself for MEF cache invalidation. /BUILD-ID
            # writes a content-hash RSDS record without producing a PDB —
            # this is Linux's --build-id=md5 line above, in COFF spelling.
            "-Wl,/BUILD-ID",
        ],
    }) + select({
        # Sanitizers are split across multiple libraries, some of which aren't linked to shared libraries
        "//:asan_linux": ["-Wl,-z,undefs"],
        "//:tsan_linux": ["-Wl,-z,undefs"],
        "//:ubsan_linux": ["-Wl,-z,undefs"],
        # Error on undefined symbols
        "@platforms//os:linux": ["-Wl,-z,defs"],
        "//conditions:default": [],
    }) + select({
        "//:modular_config_coverage": ["-fprofile-instr-generate"],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "link_executable_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_executable_actions"],
    args = select({
        # PE images are relocatable through ASLR, and there is no rpath: the
        # loader resolves DLLs by search path, so neither flag has a meaning
        # lld-link would accept.
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wl,-pie"],
    }) + select({
        "@platforms//os:macos": [
            "-Wl,-rpath,@loader_path/../lib",
        ],
        "@platforms//os:linux": [
            "-Wl,-rpath,$ORIGIN/../lib",
        ],
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "link_shared_library_args",
    actions = ["@rules_cc//cc/toolchains/actions:dynamic_library_link_actions"],
    args = select({
        "@platforms//os:macos": [
            "-Wl,-rpath,@loader_path",
            "-Wl,-rpath,@loader_path/../lib",
        ],
        "@platforms//os:linux": [
            "-Wl,-rpath,$ORIGIN",
            "-Wl,-rpath,$ORIGIN/../lib",
        ],
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "opt_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-D_FORTIFY_SOURCE=1",
        "-DNS_BLOCK_ASSERTIONS=1",
    ],
)

cc_args(
    name = "opt_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = select({
        "@platforms//os:linux": ["-Wl,--gc-sections"],
        "@platforms//os:macos": ["-Wl,-dead_strip"],
        # /OPT:REF is lld-link's equivalent dead-strip. It is already the
        # default for a release link, but not once /DEBUG is present, so state
        # it rather than depend on that interaction.
        "@platforms//os:windows": ["-Wl,/OPT:REF"],
    }),
)

cc_args(
    name = "non_opt_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = select({
        "@platforms//os:macos": ["-Wl,-no_deduplicate"],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "asan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=address",
    ],
)

cc_args(
    name = "asan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=address",
        "-shared-libsan",
    ],
)

cc_args(
    name = "tsan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=thread",
    ],
)

cc_args(
    name = "tsan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=thread",
    ],
)

cc_args(
    name = "ubsan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=undefined",
        "-fno-sanitize=vptr",  # requires rtti
    ],
)

cc_args(
    name = "ubsan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=undefined",
        # Note: we intentionally don't add `-shared-libsan` here. Doing so
        # makes every UBSan-instrumented binary (including build-time tools
        # like kgen) depend on libclang_rt.ubsan_standalone.so at runtime,
        # but build actions don't get the LD_PRELOAD wiring from
        # runtime_sanitizer_env, so they would fail with "cannot open shared
        # object file". For the dlopen-from-Python case (kbench), we instead
        # rely on the loader explicitly preloading libubsan via
        # ctypes.CDLL(..., mode=RTLD_GLOBAL) before opening the user .so.
        # See kbench_model.py and MOTO-1576.
    ],
)

cc_args(
    name = "generate_dsym",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["--modular-dsym-path={dsym_path}"],
    format = {"dsym_path": "@rules_cc//cc/toolchains/variables:dsym_path"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:dsym_path",
)

cc_args(
    name = "output_exec_path",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["--modular-binary-path={output_execpath}"],
    format = {"output_execpath": "@rules_cc//cc/toolchains/variables:output_execpath"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:output_execpath",
)

# TODO: Try to replace with https://github.com/bazelbuild/rules_cc/pull/529
cc_args(
    name = "layering_check_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fmodules-strict-decluse",
        "-Wprivate-header",
    ],
)

cc_args(
    name = "module_name_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + ["-fmodule-name={module_name}"],
    format = {
        "module_name": "@rules_cc//cc/toolchains/variables:module_name",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_name",
)

cc_args(
    name = "module_map_file_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + ["-fmodule-map-file={module_map_file}"],
    format = {
        "module_map_file": "@rules_cc//cc/toolchains/variables:module_map_file",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_map_file",
)

cc_args(
    name = "dependent_module_map_files",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + [
        "-fmodule-map-file={dependent_module_map_files}",
    ],
    format = {
        "dependent_module_map_files": "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    },
    iterate_over = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    requires_not_none = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
)

cc_args(
    name = "parse_headers_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_header_parsing"],
    args = [
        "-xc++-header",  # TODO: This is wrong for C only headers https://github.com/bazelbuild/bazel/pull/22971
        "-fsyntax-only",
    ],
    env = {
        "PARSE_HEADER": "{output_file}",
    },
    format = {"output_file": "@rules_cc//cc/toolchains/variables:output_file"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:output_file",
)

# TODO: Ideally these would be fixed in rules_cc
cc_args(
    name = "ignore_unused_command_line_argument",
    actions = [
        "@rules_cc//cc/toolchains/actions:lto_backend",
        "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
    ],
    args = ["-Wno-unused-command-line-argument"],
)

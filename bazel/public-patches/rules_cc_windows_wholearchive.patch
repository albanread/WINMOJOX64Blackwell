+def windows_wholearchive_library_args(name, variable):
+    """Declares /wholearchive: argument expansion for a library on Windows.
+
+    lld-link has no --whole-archive/--no-whole-archive bracketing switches;
+    the per-file spelling /wholearchive:<library> is the COFF equivalent, so
+    the library expands to -Wl,/wholearchive:<library> when it must be linked
+    as a whole archive and to its bare path otherwise. This mirrors the
+    Apple -force_load mechanism above.
+
+    Args:
+      name: The name of the rule.
+      variable: The variable to expand.
+    """
+    cc_nested_args(
+        name = name,
+        nested = [
+            ":{}_wholearchive_library".format(name),
+            ":{}_no_wholearchive_library".format(name),
+        ],
+    )
+    cc_nested_args(
+        name = name + "_no_wholearchive_library",
+        requires_false = "//cc/toolchains/variables:libraries_to_link.is_whole_archive",
+        args = ["{library}"],
+        format = {
+            "library": variable,
+        },
+    )
+    cc_nested_args(
+        name = name + "_wholearchive_library",
+        requires_true = "//cc/toolchains/variables:libraries_to_link.is_whole_archive",
+        args = ["-Wl,/wholearchive:{library}"],
+        format = {
+            "library": variable,
+        },
+    )
+
 def library_link_args(name, library_type, from_variable, iterate_over_variable = False):

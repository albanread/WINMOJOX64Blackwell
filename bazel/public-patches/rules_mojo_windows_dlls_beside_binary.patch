+    def _materialize_windows_dlls(executable):
+        outputs = []
+        if executable.extension != "exe":
+            return outputs
+        seen = {}
+        for dll in windows_dlls:
+            if dll.basename in seen:
+                continue
+            seen[dll.basename] = True
+            out = ctx.actions.declare_file(dll.basename, sibling = executable)
+            ctx.actions.symlink(output = out, target_file = dll)
+            outputs.append(out)
+        return outputs
 

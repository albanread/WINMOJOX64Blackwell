diff --git a/absl/base/BUILD.bazel b/absl/base/BUILD.bazel
index 2b380e6..1649d41 100644
--- a/absl/base/BUILD.bazel
+++ b/absl/base/BUILD.bazel
@@ -960,6 +960,12 @@ cc_library(
         "//absl/base:config",
         "//absl/base:core_headers",
     ],
+    # alwayslink for PE/COFF: this target carries ABSL_ATTRIBUTE_WEAK
+    # definitions. A weak definition inside an archive does not pull its
+    # member in, since only a strong undefined reference does, and ELF then
+    # resolves the leftover weak reference to zero. lld-link instead reports
+    # an undefined symbol, so the whole archive has to participate.
+    alwayslink = 1,
 )
 

+        # Windows CPython ships its runtime as pythonXY.dll rather than
+        # libpython*. python3.dll is excluded: it is the stable-ABI forwarding
+        # stub, while the full API needed for embedding lives in e.g.
+        # python312.dll.
+        if (file.basename.startswith("python3") and
+            file.basename.endswith(".dll") and
+            file.basename != "python3.dll"):
+            libpython = file.short_path
+            break
+
     if not libpython:

+
+    # Passing `environment` to rctx.execute replaces the environment outright
+    # rather than extending it. On Windows that drops SystemRoot, and without
+    # it Winsock cannot load its service providers, so any import reaching
+    # asyncio dies with WinError 10106. pip imports tenacity, which imports
+    # asyncio, so every wheel install fails. Matched case-insensitively
+    # because the casing Bazel reports for these is not guaranteed.
+    if rctx.os.name.startswith("windows"):
+        _keep = ["systemroot", "systemdrive", "temp", "tmp"]
+        _have_systemroot = False
+        for _key, _value in rctx.os.environ.items():
+            if _key.lower() in _keep:
+                env[_key] = _value
+                if _key.lower() == "systemroot":
+                    _have_systemroot = True
+        if not _have_systemroot:
+            env["SystemRoot"] = "C:\\Windows"
+

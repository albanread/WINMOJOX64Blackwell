+        # so detection does not depend on what leaked through.
+        if not nvidia_smi and rctx.os.name.startswith("windows"):
+            for candidate in [
+                "C:/Windows/System32/nvidia-smi.exe",
+                "C:/Program Files/NVIDIA Corporation/NVSMI/nvidia-smi.exe",
+            ]:
+                if rctx.path(candidate).exists:
+                    nvidia_smi = rctx.path(candidate)
+                    break
+
         # amd-smi supersedes rocm-smi
         amd_smi = rctx.which("amd-smi")

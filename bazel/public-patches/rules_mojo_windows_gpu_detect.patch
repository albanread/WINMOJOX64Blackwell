+
+    elif is_smi_host and (rctx.os.arch == "amd64" or rctx.os.arch == "aarch64"):
         # A system may have both rocm-smi and nvidia-smi installed, check both.
         nvidia_smi = rctx.which("nvidia-smi")
 
+        if not nvidia_smi:
+            nvidia_smi = rctx.which("nvidia-smi.exe")
+
